+
+static const BITMAPINFOHEADER *MediaBitmap(const AM_MEDIA_TYPE *pmt)
+{
+	if (!pmt || pmt->majortype != MEDIATYPE_Video || !pmt->pbFormat)
+		return nullptr;
+	if (pmt->formattype == FORMAT_VideoInfo) {
+		if (pmt->cbFormat < sizeof(VIDEOINFOHEADER))
+			return nullptr;
+	} else if (pmt->formattype == FORMAT_VideoInfo2) {
+		if (pmt->cbFormat < sizeof(VIDEOINFOHEADER2))
+			return nullptr;
+	} else {
+		return nullptr;
+	}
+	return GetBitmapInfoHeader(*pmt);
+}
+
+bool OutputPin::IsValidMediaType(const AM_MEDIA_TYPE *pmt) const
+{
+	const BITMAPINFOHEADER *bih = MediaBitmap(pmt);
+	if (!bih)
+		return false;
+	VideoFormat format;
+	if (!GetMediaTypeVFormat(*pmt, format) ||
+	    (format != VideoFormat::NV12 && format != VideoFormat::I420 && format != VideoFormat::YUY2))
+		return false;
+	return bih->biSize >= sizeof(BITMAPINFOHEADER) && bih->biPlanes == 1 &&
+	       bih->biBitCount == VFormatBits(format) &&
+	       (bih->biCompression == VFormatToFourCC(format) ||
+		(format == VideoFormat::I420 && bih->biCompression == MAKEFOURCC('I', 'Y', 'U', 'V'))) &&
+	       Dualcast::supported_size(bih->biWidth, bih->biHeight) &&
+	       Dualcast::supported_interval(MediaInterval(pmt));
 }
 
