{
  "name": "dualcast-independent",
  "productName": "Dualcast Independent",
  "version": "0.4.6",
  "private": true,
  "description": "Independent screen capture and RTMP broadcaster",
  "main": "src/main.cjs",
  "scripts": {
    "build": "node build.cjs",
    "start": "npm run build && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "npm run build && electron tests/electron-stability.cjs",
    "test:main": "npm run build && electron tests/main-smoke.cjs",
    "test:logs": "npm run build && electron tests/logs-smoke.cjs",
    "test:ui": "npm run build && electron tests/ui-smoke.cjs",
    "test:camera": "npm run build && electron tests/camera-smoke.cjs",
    "test:camera-install": "npm run build && electron tests/camera-install-smoke.cjs",
    "test:dual-audio": "electron tests/audio-dual-smoke.cjs",
    "test:updates": "electron tests/updates-smoke.cjs",
    "test:updates:github": "electron tests/updates-github.cjs",
    "build:camera": "node native-camera/build.cjs",
    "package:win": "npm run build && node package-win.cjs",
    "package:win:installer": "npm run package:win && node package-installer.cjs",
    "package:mac": "npm run build && electron-packager . 'Dualcast Independent' --platform=darwin --arch=arm64 --app-bundle-id=com.local.dualcast.independent --out=release --overwrite --asar.unpackDir=node_modules/ffmpeg-static --extend-info=resources/usage.plist --ignore='^/(release|tests|output|\\.playwright-cli|\\.git|README.previous.md)($|/)'"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ffmpeg-static": "5.3.0",
    "koffi": "2.14.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^41.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "lucide": "^0.577.0"
  }
}
